# ==============================================================================
# Silicon Verdict Autonomous Automation Pipeline - Environment Variables
# ==============================================================================

# Google Gemini API (Empirical script, telemetry, and metadata generation)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional fallback providers, used automatically when every Gemini model is unavailable (free-tier quota, saturation)

# Narration: elevenlabs = paid API first, with the local cloned voice (VoiceStudio + VoxCPM2, Apache-2.0, free,
# headless via scripts/voicestudio_server.sh) as backup; local = local voice only
TTS_BACKEND=elevenlabs
LOCAL_TTS_FALLBACK=true

# ElevenLabs API & Voice Rotation Pool (3 Active Approved Voices)
# Get your key at: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_1=onwK4e9ZLuTAKqWW03F9
ELEVENLABS_VOICE_2=pNInz6obpgDQGcFmaJgB
ELEVENLABS_VOICE_3=TX3LPaxmHKxFdv7VOQHJ
# Motion videos rotate the narrator by format (Adam judges, Liam punches; Daniel is retired); false = always Liam
MOTION_VOICE_ROTATION=true
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# YouTube Data API v3 & Channel Configuration
YOUTUBE_TOKEN_PATH=data/token.json
YOUTUBE_CLIENT_SECRETS_PATH=client_secrets.json
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_CATEGORY_ID=28

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
