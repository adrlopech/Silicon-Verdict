# Google Gemini API (Empirical script, telemetry, and metadata generation)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional fallback providers, used automatically when every Gemini model is unavailable (free-tier quota, saturation)
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b

# ElevenLabs API & Voice Rotation Pool (3 Active Approved Voices)
# Get your key at: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_1=onwK4e9ZLuTAKqWW03F9
ELEVENLABS_VOICE_2=pNInz6obpgDQGcFmaJgB
ELEVENLABS_VOICE_3=TX3LPaxmHKxFdv7VOQHJ
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Media APIs (Pixabay preferred, Pexels optional fallback)
PIXABAY_API_KEY=your_pixabay_api_key_here
PEXELS_API_KEY=

# YouTube Data API v3 & Channel Configuration
YOUTUBE_TOKEN_PATH=data/token.json
YOUTUBE_CLIENT_SECRETS_PATH=client_secrets.json
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_CATEGORY_ID=28

# TikTok Content Posting API Configuration
TIKTOK_CLIENT_KEY=your_tiktok_client_key_here
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret_here
TIKTOK_TOKEN_PATH=data/tiktok_token.json
TIKTOK_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE

# Production Scheduling & Rotation
PUBLISH_TIME=14:00

# Notifications (Optional: leave blank if not in use)
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CLOUDFLARE_ACCOUNT_ID=
