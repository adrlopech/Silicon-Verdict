# ==============================================================================
# YouTube Autonomous Automation Pipeline - Environment Variables
# ==============================================================================

# Google Gemini API (Script, storyboard, and metadata generation)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_MODEL=gemini-2.0-flash

# ElevenLabs API (Realistic neural voice synthesis)
# Get your key at: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Pexels API (Stock HD video footage & image fallbacks)
# Get your free key at: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# YouTube Data API v3 & Channel Configuration
YOUTUBE_TOKEN_PATH=tokens/token.json
YOUTUBE_CLIENT_SECRETS_PATH=tokens/client_secret.json
YOUTUBE_PRIVACY_STATUS=unlisted
YOUTUBE_CATEGORY_ID=28

# Notifications (Optional: leave blank if not in use)
# Discord Webhook URL for rich status alerts
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
# Telegram Bot Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
